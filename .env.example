# ==========================================
# ঢাকা (Dhaka) News Portal - Environment Variables
# ==========================================

# General Application Settings
VITE_SITE_URL=https://dhaka.news
VITE_SITE_NAME="ঢাকা"
VITE_SITE_TAGLINE="দেশ ও বিশ্বের সর্বশেষ সংবাদ"

# Google Analytics 4 (GA4)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Adsterra Advertising Network Configuration
# (Can also be managed directly from Admin -> Advertisements)
VITE_ADSTERRA_ENABLED=true
VITE_ADSTERRA_POPUNDER_KEY=
VITE_ADSTERRA_SOCIALBAR_KEY=

# Backend & Database Configuration (Optional external PostgreSQL)
DATABASE_URL=postgresql://dhaka_user:password@localhost:5432/dhaka_news
ADMIN_JWT_SECRET=super_secret_jwt_key_replace_in_production_32chars

# Deployment Pipeline
NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/your-hook-id
